.PARAM VPOS = 6000
.PARAM VNEG = -6000
E1 VOUT+ VOUT- VALUE={MAX(MIN(GAIN*V(VC+,VC-),VPOS),VNEG)}
.ENDS  VCVS_LIMIT_1_OPA149
*
.SUBCKT VCVS_LIMIT_2_OPA149  VC+ VC- VOUT+ VOUT-
