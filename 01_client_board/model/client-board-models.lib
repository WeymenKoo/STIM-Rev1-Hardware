.SUBCKT FEMT_0_OPA149  1 2
.PARAM NLFF=275
.PARAM FLWF=100M
.PARAM NVRF=120
.PARAM GLFF={PWR(FLWF,0.25)*NLFF/1164}
.PARAM RNVF={1.184*PWR(NVRF,2)}
.MODEL DVNF D KF={PWR(FLWF,0.5)/1E11} IS=1.0E-16
I1 0 7 10E-3
I2 0 8 10E-3
D1 7 0 DVNF
D2 8 0 DVNF
E1 3 6 7 8 {GLFF}
R1 3 0 1E9
R2 3 0 1E9
R3 3 6 1E9
E2 6 4 5 0 10
R4 5 0 {RNVF}
R5 5 0 {RNVF}
R6 3 4 1E9
R7 4 0 1E9
G1 1 2 3 4 1E-6
C1 1 0 1E-15
C2 2 0 1E-15
C3 1 2 1E-15
.ENDS  FEMT_0_OPA149
*
.SUBCKT IDEAL_D_0_OPA149  A C
D1 A C DNOM
.MODEL DNOM D (TT=10P CJO=1E-18 IS=1E-15 RS=1E-3)
.ENDS  IDEAL_D_0_OPA149
*
.SUBCKT IDEAL_D_1_OPA149  A C
D1 A C DNOM 
.MODEL DNOM D (TT=10P CJO=1E-18 IS=1E-15 RS=1E-3)
.ENDS  IDEAL_D_1_OPA149
*
.SUBCKT RNOISE_FREE_0_OPA149  1 2
.PARAM ROHMS=1E6
ERES 1 3 VALUE = { I(VSENSE) * ROHMS }
RDUMMY 30 3 1
VSENSE 30 2 DC 0V
.ENDS  RNOISE_FREE_0_OPA149
*
.SUBCKT RNOISE_FREE_1_OPA149  1 2
.PARAM ROHMS=1E4
ERES 1 3 VALUE = { I(VSENSE) * ROHMS }
RDUMMY 30 3 1
VSENSE 30 2 DC 0V
.ENDS  RNOISE_FREE_1_OPA149
*
.SUBCKT VCCS_LIMIT_0_OPA149  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 100U
.PARAM IPOS = .5
.PARAM INEG = -.5
G1 IOUT+ IOUT- VALUE={MAX(MIN(GAIN*V(VC+,VC-),IPOS),INEG)}
.ENDS  VCCS_LIMIT_0_OPA149
*
.SUBCKT VCCS_LIMIT_1_OPA149  VC+ VC- IOUT+ IOUT-
.PARAM GAIN = 1
.PARAM IPOS = 2
.PARAM INEG = -2
G1 IOUT+ IOUT- VALUE={MAX(MIN(GAIN*V(VC+,VC-),IPOS),INEG)}
.ENDS  VCCS_LIMIT_1_OPA149
*
.SUBCKT VCVS_LIMIT_0_OPA149  VC+ VC- VOUT+ VOUT-
.PARAM GAIN = 1
.PARAM VPOS = 10M
.PARAM VNEG = -10M
E1 VOUT+ VOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),VNEG,VPOS)}
.ENDS  VCVS_LIMIT_0_OPA149
*
.SUBCKT VCVS_LIMIT_1_OPA149  VC+ VC- VOUT+ VOUT-
