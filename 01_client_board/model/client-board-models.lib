.PARAM VPOS = 20M
.PARAM VNEG = -20M
E1 VOUT+ VOUT- VALUE={MAX(MIN(GAIN*V(VC+,VC-),VPOS),VNEG)}
.ENDS  VCVS_LIMIT_2_OPA149
*
.SUBCKT VCVS_LIMIT_3_OPA149  VC+ VC- VOUT+ VOUT-
