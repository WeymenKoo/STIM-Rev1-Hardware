				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "fe4fc05d-ac80-46ad-a9ca-2a0bd41b7b78")
	)
	(text_box "MISC NOTE M1:\nBring-up order: these rails before anything digital (R5 in the acceptance table): TP36 = 5.04 +/- 0.1 V, TP37 = 3.30 +/- 0.07 V with J3 unplugged. +12V_IN now carries ~+40 mA extra: check the bench supply limit and D8."
		(exclude_from_sim no)
		(at 85.09 101.6 0)
		(size 62 13)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
