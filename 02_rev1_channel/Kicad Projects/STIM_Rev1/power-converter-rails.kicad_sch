			(justify left top)
		)
		(uuid "df94842c-c5c7-4c99-b126-ba539fd5df42")
	)
	(text_box "LAYOUT NOTE L1:\nSame rules as sheet [4] L1: PowerPAD (pin 9) to GND with vias, CIN / COUT / NR cap at the pins. Place U47 near the isolators (side 2) and U46 near U41."
		(exclude_from_sim no)
