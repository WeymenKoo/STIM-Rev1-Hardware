(version 1)
# STIM Rev 1: custom DRC rules. Generated by SPICE_SIM/4-rev1-design/05_schematic/tools/gen_schematic.py.
# Sources (full list: SPICE_SIM/4-rev1-design/07_pcb/design-rules-research.md):
#  [IPC] IPC-2221B Table 6-1 (B1 internal, B2 external uncoated <= 3050 m). Worst pair +HV to -HV = 220 V -> B2 1.25 mm,
#        B1 0.2 mm. HV to GND/logic 110 V -> B2 0.6 mm. No conformal coating assumed (B4 not claimed).
#  [JLC] JLCPCB capabilities (4-layer, 1 oz outer): track width tolerance +/-20 %, inner via-to-copper 0.2 mm,
#        non-plated slot >= 1.0 mm.
#  [SLUP419] TI, Zhang & LaBella 2024: IPC-2221B covers functional spacing only; user-safety insulation is IEC 60664-1 /
#        IEC 60601-1 and is out of scope for this bench board.
# Chosen: 1.5 mm = 1.25 mm [IPC] + 20 % [JLC tolerance, mask registration], clearance AND creepage.
# Netclasses: HV_POS (+rail side), HV_NEG (-rail side), HV_OUT (floats with the output, +/-110 V).
# KiCad applies the LAST matching rule, so the per-package exceptions are at the end.

(rule "HV to LV clearance"
    (constraint clearance (min 1.5mm))
    (condition "(A.hasNetclass('HV_POS') || A.hasNetclass('HV_NEG') || A.hasNetclass('HV_OUT')) && !(B.hasNetclass('HV_POS') || B.hasNetclass('HV_NEG') || B.hasNetclass('HV_OUT'))"))

(rule "HV to LV creepage"
    (constraint creepage (min 1.5mm))
    (condition "(A.hasNetclass('HV_POS') || A.hasNetclass('HV_NEG') || A.hasNetclass('HV_OUT')) && !(B.hasNetclass('HV_POS') || B.hasNetclass('HV_NEG') || B.hasNetclass('HV_OUT')) && !((A.memberOfFootprint('U2') && B.memberOfFootprint('U2')) || (A.memberOfFootprint('QD1') && B.memberOfFootprint('QD1')) || (A.memberOfFootprint('QD2') && B.memberOfFootprint('QD2')))"))

(rule "HV_POS to HV_NEG (220 V)"
    (constraint clearance (min 1.5mm))
    (constraint creepage (min 1.5mm))
    (condition "A.hasNetclass('HV_POS') && B.hasNetclass('HV_NEG') && !((A.memberOfFootprint('U2') && B.memberOfFootprint('U2')) || (A.memberOfFootprint('QD1') && B.memberOfFootprint('QD1')) || (A.memberOfFootprint('QD2') && B.memberOfFootprint('QD2')))"))

(rule "HV rails to HV_OUT (up to 220 V)"
    (constraint clearance (min 1.5mm))
    (constraint creepage (min 1.5mm))
    (condition "(A.hasNetclass('HV_POS') || A.hasNetclass('HV_NEG')) && B.hasNetclass('HV_OUT') && !((A.memberOfFootprint('U2') && B.memberOfFootprint('U2')) || (A.memberOfFootprint('QD1') && B.memberOfFootprint('QD1')) || (A.memberOfFootprint('QD2') && B.memberOfFootprint('QD2')))"))

# Same rail side: normally < 1 V apart, up to 110 V if a shunt opens -> B2 101-150 V 0.6 mm [IPC]
(rule "HV_POS net to net"
    (constraint clearance (min 0.6mm))
    (condition "A.hasNetclass('HV_POS') && B.hasNetclass('HV_POS') && A.Net != B.Net"))

(rule "HV_NEG net to net"
    (constraint clearance (min 0.6mm))
    (condition "A.hasNetclass('HV_NEG') && B.hasNetclass('HV_NEG') && A.Net != B.Net"))

# Inner layers: B1 0.2 mm [IPC]; 0.5 mm keeps plane antipads around HV via barrels well clear [JLC inner 0.2 mm]
(rule "HV inner-layer clearance"
    (layer inner)
    (constraint clearance (min 0.5mm))
    (condition "(A.hasNetclass('HV_POS') || A.hasNetclass('HV_NEG') || A.hasNetclass('HV_OUT')) && A.Net != B.Net"))

(rule "HV tracks width"
    (constraint track_width (min 0.3mm))
    (condition "A.hasNetclass('HV_POS') || A.hasNetclass('HV_NEG') || A.hasNetclass('HV_OUT')"))

# Isolation slots: draw a rule area named ISOLATION_SLOT where a routed slot adds creepage; JLCPCB NPTH slot >= 1.0 mm
(rule "isolation slot width"
    (constraint edge_clearance (min 0.3mm))
    (condition "A.intersectsArea('ISOLATION_SLOT')"))

# Rated packages whose own pin spacing is below the HV rules (INA149 SOIC-8 275 V CM; MMBTA42/92 SOT-23 300 V;
# BAS16 NC pin). Only pad-to-pad inside the SAME footprint is relaxed; tracks and other parts still obey the rules.

(rule "intra-package U2"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U2') && B.memberOfFootprint('U2')"))

(rule "intra-package QD1"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('QD1') && B.memberOfFootprint('QD1')"))

(rule "intra-package QD2"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('QD2') && B.memberOfFootprint('QD2')"))

(rule "intra-package D1"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('D1') && B.memberOfFootprint('D1')"))

(rule "intra-package D1B1"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('D1B1') && B.memberOfFootprint('D1B1')"))

(rule "intra-package D2"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('D2') && B.memberOfFootprint('D2')"))

(rule "intra-package D2B1"
    (severity ignore)
    (constraint clearance (min 0.2mm))
    (constraint creepage (min 0mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('D2B1') && B.memberOfFootprint('D2B1')"))

# 0.65 mm pitch VSSOP-8 (TPS7A4901 / TPS7A3001): 0.15 mm between pads is the package, JLCPCB minimum 0.1 mm
(rule "fine-pitch LDO pads"
    (constraint clearance (min 0.15mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('U30') && B.memberOfFootprint('U30')) || (A.memberOfFootprint('U31') && B.memberOfFootprint('U31')))"))
