		(uuid "4a1639e5-d11c-5cd5-b666-114ed39b41d2")
	)
	(text_box "DESIGN NOTE D1:\nF1/F2 Littelfuse 0451.500MRL (NANO2, 500 mA fast, 125 VAC/VDC, LCSC C142836). Covers a rail-to-GND fault (<= 110 V). A +HV to -HV short puts up to 220 V across the first fuse to open: fine at +/-30 V bench rails; for +/-100 V find a >= 250 VDC part or accept the risk (open item). R23/R24 bleed C2/C3 (tau 0.2 s)."
		(exclude_from_sim no)
		(at 125.8 115.6 0)
		(size 52 16.7916)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a0e5069f-9125-4296-a270-d7a755970f73")
	)
	(text_box "DESIGN NOTE D2:\nRSP/RSN 10 Ohm 1 W: rail current = (TP1 - TP2) / 10 Ohm, 10 mV per mA. 2512 so a board short, limited by the fuse, does not open them."
		(exclude_from_sim no)
		(at 125.8 135.92 0)
		(size 52 11.4)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
