				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a0e57633-3e54-42b1-890f-2789f77d4de5")
	)
	(text_box "LAYOUT NOTE L1:\nHV island: 1.5 mm clearance and creepage from +/-HV to everything else and between +HV and -HV (L1/L4); 0.6 mm within one rail side; HV tracks >= 0.3 mm; 0.5 mm antipads on L2/L3."
		(exclude_from_sim no)
		(at 38.1 80.01 0)
		(size 52 13.6)
		(margins 1 1 1 1)
