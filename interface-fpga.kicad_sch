	(text_box "LAYOUT NOTE L1:\nJ3 on the left (LV) edge. Every signal has a GND neighbour on the ribbon; keep the five signals over unbroken L2."
		(exclude_from_sim no)
		(at 186.76 81.31 0)
		(size 52 11.4)
