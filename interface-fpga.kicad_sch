			(justify left top)
		)
		(uuid "a0e55117-c5eb-416f-b879-3488f1c5cd9f")
	)
	(text_box "DESIGN NOTE D1:\nJ3: 1 DAC_CMD (+/-5 V = +/-5 mA), 3 ENABLE (3.3 V logic; low or open = switches open), 5 I_RETURN_ADC, 7 V_ELEC_ADC, 9 VMID_REF; even pins GND. No power on J3."
		(exclude_from_sim no)
		(at 186.76 67.37 0)
		(size 52 11.4)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a0e58381-7da8-4c47-8179-6f961d1051b2")
	)
	(text_box "MISC NOTE M1:\nFPGA: hold DAC = 0 for 3 ms after ENABLE (D-08; the AQY214S closes in 0.5 ms, so this can shorten); clear the DAC when ENABLE drops; subtract VMID_REF from both read-back channels."
		(exclude_from_sim no)
