	)
	(text_box "MISC NOTE M1:\nJP1/JP2 bench bias: CLOSE at +/-30 V or below; OPEN at +/-100 V (RB1/RB2 would see ~190 V, ~0.9 W in a 0.25 W part)."
		(exclude_from_sim no)
		(at 218.67 59.38 0)
