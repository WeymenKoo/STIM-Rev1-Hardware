	(text_box "DESIGN NOTE D1:\n1 mA/V set by R7 = 1.00 k 0.1 % 25 ppm (0805 for self-heating). U2 INA149 senses across R7; U1 OPA192 buffers I_SENSE back to the REF pins (D-05)."
		(exclude_from_sim no)
		(at 301.22 154.97 0)
