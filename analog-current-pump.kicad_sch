	(text_box "MISC NOTE M2:\nTP17 PUMP_OUT, TP18 PUMP_REF, TP19/TP20 floating rails (span >= 4.5 V), TP21 I_SENSE: all float up to +/-110 V; use a differential or isolated probe."
		(exclude_from_sim no)
		(at 161.52 152.43 0)
		(size 62 11.4)
