				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a0e592a3-0d4a-4829-a48c-06ccd52845bf")
	)
	(text_box "DESIGN NOTE D2:\nU3 OPA192 on +/-9 V, unity buffer: its rails bound DAC_BUF if a zener opens (ceiling 9.15 mA, D-01). 25 uV offset: KPI 1 passes without calibration (D-21)."
		(exclude_from_sim no)
		(at 82.62 64.8 0)
		(size 52 11.4)
