	(text_box "LAYOUT NOTE L1:\nC30/C31 100 nF beside the U3 supply pins, via at the pad to L2 (D4)."
		(exclude_from_sim no)
		(at 170.25 64.46 0)
		(size 52 9.2)
		(margins 1 1 1 1)
		(stroke
