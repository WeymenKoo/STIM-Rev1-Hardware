			)
			(justify left top)
		)
		(uuid "a0e542b9-27bc-4043-aa1b-95a53ff79a1c")
	)
	(text_box "DESIGN NOTE D1:\nClamp: RS1 and two BZX84C6V2 in series to GND limit DAC_CLAMP to about +/-6.3-7.4 V, so a runaway DAC is held to ~6.3-7.4 mA, inside the limiter."
		(exclude_from_sim no)
		(at 54.68 101.63 0)
		(size 52 11.4)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "a0e58358-abb1-43ee-8f9c-5c937f8275b8")
	)
	(text_box "MISC NOTE M1:\nTP13 DAC_CMD -> TP15 DAC_CLAMP -> TP16 DAC_BUF: probe all three to see the clamp act."
		(exclude_from_sim no)
		(at 82.62 51.76 0)
		(size 52 9.2)
		(margins 1 1 1 1)
		(stroke
			(width 0.8)
			(type solid)
